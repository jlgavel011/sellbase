# Written by `npx sellbase init` into .env.local (public values only).
# For a deploy, copy them from your hosted Supabase project (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon or publishable key>
NEXT_PUBLIC_SELLBASE_URL=https://<project>.supabase.co/functions/v1/sellbase-api
# Your site's public URL (SEO and links in emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
