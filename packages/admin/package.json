{
  "name": "@sellbase/admin",
  "version": "0.3.2",
  "description": "Sellbase admin SPA. Mount it at /admin in any React app; customize with config, slots and pages.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./standalone/*": "./dist/standalone/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tailwindcss -i src/styles.css -o dist/styles.css --minify && node build-standalone.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sellbase/sdk": "workspace:*",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "esbuild": "^0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlgavel011/sellbase.git",
    "directory": "packages/admin"
  },
  "homepage": "https://github.com/jlgavel011/sellbase#readme",
  "bugs": {
    "url": "https://github.com/jlgavel011/sellbase/issues"
  },
  "keywords": [
    "ecommerce",
    "admin",
    "react",
    "dashboard",
    "shopify-alternative"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
