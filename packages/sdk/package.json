{
  "name": "@sellbase/sdk",
  "version": "0.3.3",
  "description": "Typed client for the Sellbase API (browser and server).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sellbase/core": "workspace:*",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlgavel011/sellbase.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/jlgavel011/sellbase#readme",
  "bugs": {
    "url": "https://github.com/jlgavel011/sellbase/issues"
  },
  "keywords": [
    "sellbase",
    "ecommerce",
    "e-commerce",
    "commerce",
    "nextjs",
    "supabase",
    "stripe",
    "shopify-alternative",
    "open-source",
    "sdk",
    "api-client",
    "typescript",
    "seo",
    "json-ld"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
