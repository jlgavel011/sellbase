{
  "name": "@sellbase/sdk",
  "version": "0.3.0",
  "description": "Typed client for the Sellbase API (browser and server).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sellbase/core": "workspace:*",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlgavel011/sellbase.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/jlgavel011/sellbase#readme",
  "bugs": {
    "url": "https://github.com/jlgavel011/sellbase/issues"
  },
  "keywords": [
    "ecommerce",
    "sdk",
    "api-client"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  }
}
