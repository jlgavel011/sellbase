{
  "name": "sellbase",
  "version": "0.3.0",
  "description": "Add commerce to any app your AI builds: `npx sellbase init`.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sellbase": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "node scripts/copy-assets.mjs && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sellbase/core": "workspace:*",
    "@sellbase/mcp": "workspace:*",
    "@sellbase/sdk": "workspace:*",
    "commander": "^15.0.0",
    "diff": "^8.0.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@sellbase/api": "workspace:*",
    "@sellbase/web": "workspace:*",
    "@sellbase/admin": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlgavel011/sellbase.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/jlgavel011/sellbase#readme",
  "bugs": {
    "url": "https://github.com/jlgavel011/sellbase/issues"
  },
  "keywords": [
    "ecommerce",
    "supabase",
    "cli",
    "ai",
    "shopify-alternative"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  }
}
