{
  "name": "sellbase",
  "version": "0.3.3",
  "description": "Open source Shopify alternative: add products, cart, Stripe checkout and an admin to your Next.js, React or HTML site on your own Supabase, run by your AI agent.",
  "mcpName": "io.github.jlgavel011/sellbase",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sellbase": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "node scripts/copy-assets.mjs && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sellbase/core": "workspace:*",
    "@sellbase/mcp": "workspace:*",
    "@sellbase/sdk": "workspace:*",
    "commander": "^15.0.0",
    "diff": "^8.0.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@sellbase/api": "workspace:*",
    "@sellbase/web": "workspace:*",
    "@sellbase/admin": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlgavel011/sellbase.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/jlgavel011/sellbase#readme",
  "bugs": {
    "url": "https://github.com/jlgavel011/sellbase/issues"
  },
  "keywords": [
    "sellbase",
    "ecommerce",
    "e-commerce",
    "commerce",
    "nextjs",
    "supabase",
    "stripe",
    "shopify-alternative",
    "open-source",
    "cli",
    "ai",
    "ai-agents",
    "mcp",
    "claude-code",
    "cursor",
    "storefront",
    "checkout",
    "headless-commerce",
    "postgres"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
