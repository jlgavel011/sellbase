{
  "name": "@sellbase/react",
  "version": "0.3.2",
  "description": "Headless React hooks for Sellbase storefronts.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sellbase/sdk": "workspace:*",
    "@tanstack/react-query": "^5.104.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlgavel011/sellbase.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/jlgavel011/sellbase#readme",
  "bugs": {
    "url": "https://github.com/jlgavel011/sellbase/issues"
  },
  "keywords": [
    "ecommerce",
    "react",
    "hooks",
    "storefront"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
