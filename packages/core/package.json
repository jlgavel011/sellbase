{
  "name": "@sellbase/core",
  "version": "0.3.2",
  "description": "Sellbase core: Zod schemas, types, state machines and pricing. Pure, no IO.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlgavel011/sellbase.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/jlgavel011/sellbase#readme",
  "bugs": {
    "url": "https://github.com/jlgavel011/sellbase/issues"
  },
  "keywords": [
    "sellbase",
    "ecommerce",
    "e-commerce",
    "commerce",
    "nextjs",
    "supabase",
    "stripe",
    "shopify-alternative",
    "open-source",
    "zod",
    "schemas",
    "types",
    "pricing"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
