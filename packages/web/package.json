{
  "name": "@sellbase/web",
  "version": "0.3.3",
  "description": "Sellbase storefront as Web Components: works in any site (HTML, WordPress, Vue, Svelte, Astro, Angular…).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sellbase.js": "./dist/sellbase.js"
  },
  "unpkg": "./dist/sellbase.js",
  "jsdelivr": "./dist/sellbase.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sellbase/sdk": "workspace:*",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlgavel011/sellbase.git",
    "directory": "packages/web"
  },
  "homepage": "https://github.com/jlgavel011/sellbase#readme",
  "bugs": {
    "url": "https://github.com/jlgavel011/sellbase/issues"
  },
  "keywords": [
    "sellbase",
    "ecommerce",
    "e-commerce",
    "commerce",
    "nextjs",
    "supabase",
    "stripe",
    "shopify-alternative",
    "open-source",
    "web-components",
    "custom-elements",
    "storefront",
    "cart",
    "checkout",
    "html",
    "wordpress",
    "webflow",
    "astro",
    "vue",
    "svelte"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
